+/// Read a complete memory image into new anonymous guest RAM.
+///
+/// [`map_guest_memory_file`] maps the image `MAP_SHARED`, so the restored
+/// guest runs on the image's page cache. Transparent huge pages do not cover a
+/// file mapping, and in a nested VM, RAM mapped 4 KiB at a time stays slow.
+/// Each region here is the anonymous RAM a cold boot gets (its host address
+/// agrees with its guest address modulo 2 MiB, see `map_aligned_guest_ram`),
+/// advised for huge pages, and the image's data extents are read into it on
+/// several threads before any vCPU runs. Holes are not read and stay
+/// unallocated. Nothing refers to the image afterwards, so the next checkpoint
+/// saves this RAM as it saves a cold-booted VM's.
+#[cfg(target_os = "linux")]
+pub fn read_guest_memory_file(
+    descs: &[MemoryRegionDesc],
+    file: &File,
+) -> io::Result<GuestMemoryMmap> {
+    if descs.is_empty() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            "snapshot contains no guest-memory regions",
+        ));
+    }
+    let started = std::time::Instant::now();
+    let mut regions = Vec::with_capacity(descs.len());
+    let mut work = Vec::new();
+    let mut offset = 0_u64;
+    for desc in descs {
+        let len = usize::try_from(desc.len).map_err(|_| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "guest-memory region does not fit host address space",
+            )
+        })?;
+        if len == 0 {
+            return Err(io::Error::new(
+                io::ErrorKind::InvalidData,
+                "zero-length guest-memory region",
+            ));
+        }
+        let mapping = crate::builder::map_aligned_guest_ram(GuestAddress(desc.gpa), len)
+            .map_err(io::Error::other)?;
+        let host = mapping.as_ptr() as usize;
+        // SAFETY: `host` and `len` describe the fresh mapping above; advice
+        // changes no contents. A kernel that refuses keeps 4 KiB pages.
+        if unsafe { libc::madvise(host as *mut libc::c_void, len, libc::MADV_HUGEPAGE) } != 0 {
+            debug!(
+                "guest RAM at 0x{:x}: MADV_HUGEPAGE: {}",
+                desc.gpa,
+                io::Error::last_os_error()
+            );
+        }
+        let extents = file_data_extents(file, offset, desc.len)?
+            .unwrap_or_else(|| vec![(0, desc.len)]);
+        for (start, end) in extents {
+            push_pieces(&mut work, start, end, |at, piece| PromotionPiece::Read {
+                fd: file.as_raw_fd(),
+                file_offset: offset + at,
+                destination: host + at as usize,
+                len: piece,
+            });
+        }
+        regions.push(
+            vm_memory::GuestRegionMmap::new(mapping, GuestAddress(desc.gpa))
+                .ok_or_else(|| io::Error::other("guest RAM region overflows"))?,
+        );
+        offset = offset.checked_add(desc.len).ok_or_else(|| {
+            io::Error::new(
+                io::ErrorKind::InvalidData,
+                "guest-memory image offset overflow",
+            )
+        })?;
+    }
+    let actual = file.metadata()?.len();
+    if offset != actual {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidData,
+            format!("guest-memory image length {actual} does not match manifest {offset}"),
+        ));
+    }
+    let memory = GuestMemoryMmap::from_regions(regions)
+        .map_err(|error| io::Error::other(format!("guest memory: {error:?}")))?;
+    run_promotion_pieces(&work)?;
+    let bytes: u64 = work
+        .iter()
+        .map(|piece| match piece {
+            PromotionPiece::Read { len, .. } | PromotionPiece::Scan { len, .. } => *len,
+        })
+        .sum();
+    info!(
+        "read {bytes} bytes of guest RAM into anonymous memory in {} ms",
+        started.elapsed().as_millis()
+    );
+    Ok(memory)
+}
