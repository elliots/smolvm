+    #[cfg(target_os = "linux")]
+    #[test]
+    fn read_memory_image_is_anonymous_aligned_and_exact() {
+        use crate::builder::create_guest_ram_memfd;
+        use std::os::unix::fs::FileExt;
+
+        let descs = [
+            MemoryRegionDesc {
+                gpa: 0x1000,
+                len: 0x20_0000,
+            },
+            MemoryRegionDesc {
+                gpa: 0x40_0000,
+                len: 0x10_0000,
+            },
+        ];
+        let file = create_guest_ram_memfd(0x30_0000).expect("sparse memory image");
+        file.write_all_at(&[0xA5; 4096], 0x1000).unwrap();
+        file.write_all_at(&[0x5A; 4096], 0x20_2000).unwrap();
+
+        let memory = read_guest_memory_file(&descs, &file).expect("read memory image");
+        for (region, desc) in memory.iter().zip(&descs) {
+            assert!(region.file_offset().is_none());
+            let host = memory.get_host_address(GuestAddress(desc.gpa)).unwrap() as u64;
+            assert_eq!(host % (2 << 20), desc.gpa % (2 << 20));
+        }
+        let mut image = vec![0_u8; 0x30_0000];
+        file.read_exact_at(&mut image, 0).unwrap();
+        let mut ram = vec![0_u8; 0x20_0000];
+        memory.read_slice(&mut ram, GuestAddress(0x1000)).unwrap();
+        assert!(ram == image[..0x20_0000]);
+        let mut ram = vec![0_u8; 0x10_0000];
+        memory.read_slice(&mut ram, GuestAddress(0x40_0000)).unwrap();
+        assert!(ram == image[0x20_0000..]);
+
+        memory.write_slice(&[0x11; 16], GuestAddress(0x2000)).unwrap();
+        let mut backing = [0_u8; 16];
+        file.read_exact_at(&mut backing, 0x1000).unwrap();
+        assert_eq!(backing, [0xA5; 16], "restored RAM must not alias the image");
+
+        let short = create_guest_ram_memfd(0x20_0000).expect("short memory image");
+        assert!(read_guest_memory_file(&descs, &short).is_err());
+    }
 }
