+        let mut image = Image::new(&regions());
+        image.fill(0, 1, 1);
+        let mut table = image.table(42);
+        table.pages[2] = BasePage::Unknown;
+        let bytes = table.encode();
+        assert_eq!(bytes.len(), TABLE_HEADER + (3 * 512 + 3) * TABLE_ENTRY);
+        assert_eq!(DeltaTable::parse(&bytes).unwrap(), table);
+        assert!(DeltaTable::parse(&bytes[..bytes.len() - 1]).is_err());
+        let mut wrong_count = bytes.clone();
+        wrong_count[24..32].copy_from_slice(&(DELTA_BLOCK * 9).to_le_bytes());
+        assert!(DeltaTable::parse(&wrong_count).is_err());
+        let mut wrong_state = bytes.clone();
+        wrong_state[TABLE_HEADER] = 9;
+        assert!(DeltaTable::parse(&wrong_state).is_err());
+        let mut wrong_page = bytes.clone();
+        wrong_page[16..24].copy_from_slice(&65536_u64.to_le_bytes());
+        assert!(DeltaTable::parse(&wrong_page).is_err());
+        let mut old_version = bytes;
+        old_version[..8].copy_from_slice(b"SMOLDTB1");
