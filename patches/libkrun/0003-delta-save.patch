+    /// Stream the pages of the image that differ from the caller's base
+    /// `table` (see [`delta`]).
+    pub fn finish_delta<W: Write + Send>(
+        self,
+        table: &DeltaTable,
+        output: &mut W,
+    ) -> io::Result<(Vec<MemoryRegionDesc>, DeltaSummary)> {
+        let stream = |sources: &delta::SourceFactory<'_>, output: &mut W| {
+            delta::stream_delta(sources, table, output, delta::DELTA_THREADS)
+        };
+        let from_files = |files: &[(&File, u64, u64)], output: &mut W| {
+            let factory = || -> io::Result<Vec<Box<dyn SparseRamSource + '_>>> {
+                Ok(files
+                    .iter()
+                    .map(|&(file, start, len)| {
+                        Box::new(SeekRamSource { file, start, len })
+                            as Box<dyn SparseRamSource + '_>
+                    })
+                    .collect())
+            };
+            stream(&factory, output)
+        };
+        match self.generation {
+            DeferredLinuxGeneration::Held(held) => {
+                held.ensure_valid()?;
+                let factory = || -> io::Result<Vec<Box<dyn SparseRamSource + '_>>> {
+                    Ok(held
+                        .sources()?
+                        .into_iter()
+                        .map(|source| Box::new(source) as Box<dyn SparseRamSource + '_>)
+                        .collect())
+                };
+                let summary = stream(&factory, output)?;
+                held.ensure_valid()?;
+                Ok((held.descs(), summary))
+            }
+            DeferredLinuxGeneration::Layered(generation) => {
+                let summary = from_files(&generation.memory_sources(), output)?;
+                Ok((generation.memory_regions(), summary))
+            }
+            generation => {
+                let (descs, files) = match generation {
+                    DeferredLinuxGeneration::Stable { descs, files } => (descs, files),
+                    DeferredLinuxGeneration::Copy(copy) => copy.finish()?,
+                    _ => unreachable!("held and layered generations are handled above"),
+                };
+                if descs.len() != files.len() {
+                    return Err(io::Error::other(
+                        "RAM generation descriptor/file count mismatch",
+                    ));
+                }
