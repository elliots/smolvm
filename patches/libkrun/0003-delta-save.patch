+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Read;
+
+    const PAGE: u64 = DELTA_PAGE;
+
+    /// RAM held in a vector. Pages marked absent cannot hold data, as anonymous
+    /// pages that were never written.
+    struct VecSource<'a> {
+        bytes: &'a [u8],
+        present: &'a [bool],
+    }
+
+    impl SparseRamSource for VecSource<'_> {
+        fn len(&self) -> u64 {
+            self.bytes.len() as u64
+        }
+
+        fn next_data(&mut self, offset: u64) -> io::Result<Option<u64>> {
+            let first = (offset / PAGE) as usize;
+            Ok((first..self.present.len())
+                .find(|&page| self.present[page])
+                .map(|page| (page as u64 * PAGE).max(offset)))
+        }
+
+        fn read_exact_at(&mut self, buffer: &mut [u8], offset: u64) -> io::Result<()> {
+            for (at, byte) in buffer.iter_mut().enumerate() {
+                let at = offset as usize + at;
+                *byte = if self.present[at / PAGE as usize] {
+                    self.bytes[at]
+                } else {
+                    0
+                };
+            }
+            Ok(())
+        }
+    }
+
+    /// Regions of a test image, with no page present.
+    struct Image {
+        regions: Vec<Vec<u8>>,
+        present: Vec<Vec<bool>>,
+    }
+
+    impl Image {
+        fn new(lens: &[usize]) -> Self {
+            Self {
+                regions: lens.iter().map(|&len| vec![0; len]).collect(),
+                present: lens
+                    .iter()
+                    .map(|&len| vec![false; len.div_ceil(PAGE as usize)])
+                    .collect(),
+            }
+        }
+
+        /// Write `byte` over `len` bytes at image offset `at`.
+        fn fill(&mut self, at: usize, len: usize, byte: u8) {
+            let mut base = 0;
+            for (region, present) in self.regions.iter_mut().zip(&mut self.present) {
+                for offset in at.max(base)..(at + len).min(base + region.len()) {
+                    region[offset - base] = byte;
+                    present[(offset - base) / PAGE as usize] = true;
+                }
+                base += region.len();
+            }
+        }
+
+        fn flat(&self) -> Vec<u8> {
+            self.regions.concat()
+        }
+
+        fn table(&self, seed: u64) -> DeltaTable {
+            let flat = self.flat();
+            DeltaTable {
+                seed,
+                image_len: flat.len() as u64,
+                pages: flat
+                    .chunks(PAGE as usize)
+                    .map(|page| page_state(page, seed))
+                    .collect(),
+            }
+        }
+
+        fn delta(&self, table: &DeltaTable) -> (Vec<u8>, DeltaSummary) {
+            let factory = || -> io::Result<Vec<Box<dyn SparseRamSource + '_>>> {
+                Ok(self
+                    .regions
+                    .iter()
+                    .zip(&self.present)
+                    .map(|(bytes, present)| {
+                        Box::new(VecSource { bytes, present }) as Box<dyn SparseRamSource + '_>
+                    })
+                    .collect())
+            };
+            let mut stream = Vec::new();
+            let summary = stream_delta(&factory, table, &mut stream, DELTA_THREADS).unwrap();
+            (stream, summary)
+        }
+    }
+
+    fn read_u64(stream: &mut &[u8]) -> u64 {
+        let mut bytes = [0; 8];
+        stream.read_exact(&mut bytes).unwrap();
+        u64::from_le_bytes(bytes)
+    }
+
+    /// What a stream changed: the pages sent, sorted, and the totals.
+    #[derive(Debug, Default)]
+    struct Applied {
+        blocks: Vec<u64>,
+        pages: Vec<u64>,
+        summary: DeltaSummary,
+    }
+
+    /// Apply a delta stream to `base` as the caller does, checking each frame.
+    fn apply(base: &mut Vec<u8>, mut stream: &[u8]) -> Applied {
+        let mut magic = [0; 8];
+        stream.read_exact(&mut magic).unwrap();
+        assert_eq!(&magic, STREAM_MAGIC);
+        assert_eq!(read_u64(&mut stream), DELTA_BLOCK);
+        assert_eq!(read_u64(&mut stream), DELTA_PAGE);
+        let image_len = read_u64(&mut stream);
+        let count = read_u64(&mut stream);
+        assert_eq!(count, image_len.div_ceil(DELTA_BLOCK));
+        base.resize(image_len as usize, 0);
+        let mut applied = Applied::default();
+        loop {
+            let mut tag = [0];
+            stream.read_exact(&mut tag).unwrap();
+            match tag[0] {
+                FRAME_PAGES => {
+                    let block = read_u64(&mut stream);
+                    assert!(block < count);
+                    assert!(!applied.blocks.contains(&block), "one frame per block");
+                    let mut maps = [0_u8; 2 * BITMAP_BYTES];
+                    stream.read_exact(&mut maps).unwrap();
+                    let (changed, data) = maps.split_at(BITMAP_BYTES);
+                    let mut any = false;
+                    for page in 0..BLOCK_PAGES {
+                        let bit = 1 << (page % 8);
+                        let is_changed = changed[page / 8] & bit != 0;
+                        let is_data = data[page / 8] & bit != 0;
+                        assert!(is_changed || !is_data, "data pages are changed pages");
+                        if !is_changed {
+                            continue;
+                        }
+                        any = true;
+                        let start = block * DELTA_BLOCK + page as u64 * PAGE;
+                        assert!(start < image_len, "no page past the image");
+                        let end = (start + PAGE).min(image_len) as usize;
+                        let bytes = &mut base[start as usize..end];
+                        if is_data {
+                            stream.read_exact(bytes).unwrap();
+                            applied.summary.data_bytes += bytes.len() as u64;
+                        } else {
+                            bytes.fill(0);
+                        }
+                        applied.pages.push(start / PAGE);
+                    }
+                    assert!(any, "a frame changes a page");
+                    applied.blocks.push(block);
+                }
+                FRAME_END => {
+                    let summary = DeltaSummary {
+                        blocks: read_u64(&mut stream),
+                        changed_blocks: read_u64(&mut stream),
+                        changed_pages: read_u64(&mut stream),
+                        data_bytes: read_u64(&mut stream),
+                    };
+                    assert!(stream.is_empty(), "nothing follows the end frame");
+                    assert_eq!(summary.blocks, count);
+                    assert_eq!(summary.changed_blocks, applied.blocks.len() as u64);
+                    assert_eq!(summary.changed_pages, applied.pages.len() as u64);
+                    assert_eq!(summary.data_bytes, applied.summary.data_bytes);
+                    applied.summary = summary;
+                    applied.blocks.sort_unstable();
+                    applied.pages.sort_unstable();
+                    return applied;
+                }
+                tag => panic!("unexpected frame {tag}"),
+            }
+        }
+    }
+
+    const MIB: usize = 1 << 20;
+    const PAGES: u64 = BLOCK_PAGES as u64;
+
+    /// Three regions: 3 MiB, 2 MiB + 12 KiB and 1 MiB. Block 1 spans the first
+    /// two, block 2 spans the last two, and block 3 is 12 KiB long.
+    fn regions() -> Vec<usize> {
+        vec![3 * MIB, 2 * MIB + 12 * 1024, MIB]
+    }
+
+    #[test]
+    fn a_delta_applied_to_its_base_gives_the_new_image() {
+        let mut old = Image::new(&regions());
+        old.fill(0, 2 * MIB, 0x11);
+        old.fill(3 * MIB - 4096, 8192, 0x22);
+        old.fill(5 * MIB, 4096, 0x33);
+        old.fill(6 * MIB + 4096, 4096, 0x44);
+        let seed = 0x5eed;
+        let table = old.table(seed);
+        assert_eq!(table.pages.len(), 3 * 512 + 3);
+
+        let mut new = Image::new(&regions());
+        // Block 0 becomes holes, as freed and zeroed memory does.
+        // Block 1 changes on both sides of the region boundary.
+        new.fill(3 * MIB - 4096, 8192, 0x23);
+        // Block 2 keeps its bytes, though a page of zeros is now present.
+        new.fill(5 * MIB, 4096, 0x33);
+        new.fill(4 * MIB, 4096, 0x00);
+        // The short final block changes one page.
+        new.fill(6 * MIB + 4096, 4096, 0x45);
+
+        let (stream, summary) = new.delta(&table);
+        let mut base = old.flat();
+        let applied = apply(&mut base, &stream);
+        assert!(base == new.flat(), "the base becomes the new image");
+        assert_eq!(applied.blocks, [0, 1, 3]);
+        let mut pages: Vec<u64> = (0..PAGES).collect();
+        pages.extend([767, 768, 3 * PAGES + 1]);
+        assert_eq!(applied.pages, pages);
+        assert_eq!(
+            summary,
+            DeltaSummary {
+                blocks: 4,
+                changed_blocks: 3,
+                changed_pages: PAGES + 3,
+                data_bytes: 3 * PAGE,
+            }
+        );
+        // The new image against its own table sends nothing.
+        let (stream, summary) = new.delta(&new.table(seed));
+        let applied = apply(&mut base, &stream);
+        assert!(applied.blocks.is_empty());
+        assert_eq!(summary.changed_pages, 0);
+        assert!(base == new.flat());
+    }
+
+    #[test]
+    fn a_block_with_one_changed_page_sends_only_that_page() {
+        let mut old = Image::new(&[4 * MIB]);
+        old.fill(0, 4 * MIB, 0x5a);
+        let mut new = Image::new(&[4 * MIB]);
+        new.fill(0, 4 * MIB, 0x5a);
+        new.fill(2 * MIB + 77 * 4096 + 100, 1, 0x01);
