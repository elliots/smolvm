--- /dev/null
+++ b/src/vmm/src/snapshot/delta.rs
@@ -0,0 +1,763 @@
+// Copyright 2026. SPDX-License-Identifier: Apache-2.0
+//
+//! Delta saves: stream only the pages of the RAM image that differ from a
+//! base image the caller keeps.
+//!
+//! The caller sends a page table: for each 4 KiB page of the image (image
+//! offset `k * 4 KiB`), whether its base holds a hole, data with a given
+//! seeded XXH3-128, or something unknown. The VMM hashes each page of guest
+//! RAM as it reads it and streams, per 2 MiB block, the pages whose state
+//! differs. Applying the frames to the base at their offsets gives the new
+//! image exactly. The VMM never writes the base.
+//!
+//! Table (caller to VMM), little-endian: `SMOLDTB2`, block size u64, page size
+//! u64, image length u64, seed u64, page count u64, then per page a state
+//! byte (0 unknown, 1 hole, 2 data) and a u128 hash (zero unless data).
+//!
+//! Stream (VMM to caller), little-endian: `SMOLDLT2`, block size u64, page
+//! size u64, image length u64, block count u64, then frames. A frame starts
+//! with a tag byte: [`FRAME_PAGES`] for a block with changed pages, followed
+//! by the block number u64, a bitmap of its changed pages and a bitmap of the
+//! changed pages that hold data (64 bytes each, page `i` of the block is bit
+//! `i % 8` of byte `i / 8`), then the bytes of each data page in order; a
+//! changed page without data reads as zeros. [`FRAME_END`] is followed by the
+//! block count, the changed block count, the changed page count and the data
+//! bytes sent (four u64); [`FRAME_ABORT`] means the save failed. A text reply
+//! line follows the end or the abort. Pages past the image's end never have
+//! a bit set, and the last page of the image may be short.
+
+use std::io::{self, Write};
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+use super::SparseRamSource;
+
+/// The block size of a delta stream's frames.
+pub const DELTA_BLOCK: u64 = 2 << 20;
+/// The page size of change detection.
+pub const DELTA_PAGE: u64 = 4096;
+/// Pages in a block.
+pub const BLOCK_PAGES: usize = (DELTA_BLOCK / DELTA_PAGE) as usize;
+/// Bytes of one bitmap of a frame.
+pub const BITMAP_BYTES: usize = BLOCK_PAGES / 8;
+const TABLE_MAGIC: &[u8; 8] = b"SMOLDTB2";
+const STREAM_MAGIC: &[u8; 8] = b"SMOLDLT2";
+/// The save failed; a reply line follows.
+pub const FRAME_ABORT: u8 = 0;
+/// A block with changed pages: its number, two bitmaps and the data pages.
+pub const FRAME_PAGES: u8 = 1;
+/// The end of the frames, followed by the totals and a reply line.
+pub const FRAME_END: u8 = 3;
+/// 1 TiB of RAM: far above any guest, small enough to allocate the table.
+const MAX_PAGES: u64 = 1 << 28;
+const TABLE_HEADER: usize = 48;
+const TABLE_ENTRY: usize = 17;
+const FRAME_HEADER: usize = 1 + 8 + 2 * BITMAP_BYTES;
+/// Threads that read and hash guest RAM.
+pub const DELTA_THREADS: usize = 4;
+
+/// What the caller's base holds for one page.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum BasePage {
+    /// Nothing known: always sent.
+    Unknown,
+    /// Reads as zeros.
+    Hole,
+    /// Data with this seeded XXH3-128.
+    Data(u128),
+}
+
+/// The caller's description of its base image.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DeltaTable {
+    pub seed: u64,
+    pub image_len: u64,
+    pub pages: Vec<BasePage>,
+}
+
+/// Totals of a delta stream.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct DeltaSummary {
+    /// Blocks in the image.
+    pub blocks: u64,
+    /// Blocks with a frame.
+    pub changed_blocks: u64,
+    /// Pages sent, with data or as zeros.
+    pub changed_pages: u64,
+    /// Bytes of the data pages sent.
+    pub data_bytes: u64,
+}
+
+fn invalid(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message.to_string())
+}
+
+fn u64_at(bytes: &[u8], at: usize) -> u64 {
+    u64::from_le_bytes(bytes[at..at + 8].try_into().unwrap())
+}
+
+impl DeltaTable {
+    /// The largest table [`Self::parse`] accepts, in bytes.
+    pub const MAX_LEN: usize = TABLE_HEADER + MAX_PAGES as usize * TABLE_ENTRY;
+
+    pub fn parse(bytes: &[u8]) -> io::Result<Self> {
+        if bytes.len() < TABLE_HEADER || &bytes[..8] != TABLE_MAGIC {
+            return Err(invalid("not a delta page table"));
+        }
+        if u64_at(bytes, 8) != DELTA_BLOCK || u64_at(bytes, 16) != DELTA_PAGE {
+            return Err(invalid("unsupported delta block or page size"));
+        }
+        let image_len = u64_at(bytes, 24);
+        let seed = u64_at(bytes, 32);
+        let count = u64_at(bytes, 40);
+        if count > MAX_PAGES || count != image_len.div_ceil(DELTA_PAGE) {
+            return Err(invalid("delta page count does not match the image length"));
+        }
+        if bytes.len() != TABLE_HEADER + count as usize * TABLE_ENTRY {
+            return Err(invalid("delta page table has the wrong length"));
+        }
+        let pages = bytes[TABLE_HEADER..]
+            .as_chunks::<TABLE_ENTRY>()
+            .0
+            .iter()
+            .map(|entry| {
+                let hash = u128::from_le_bytes(entry[1..].try_into().unwrap());
+                match entry[0] {
+                    0 => Ok(BasePage::Unknown),
+                    1 => Ok(BasePage::Hole),
+                    2 => Ok(BasePage::Data(hash)),
+                    _ => Err(invalid("unknown delta page state")),
+                }
+            })
+            .collect::<io::Result<_>>()?;
+        Ok(Self {
+            seed,
+            image_len,
+            pages,
+        })
+    }
+
+    pub fn encode(&self) -> Vec<u8> {
+        let mut bytes = Vec::with_capacity(TABLE_HEADER + self.pages.len() * TABLE_ENTRY);
+        bytes.extend_from_slice(TABLE_MAGIC);
+        for value in [
+            DELTA_BLOCK,
+            DELTA_PAGE,
+            self.image_len,
+            self.seed,
+            self.pages.len() as u64,
+        ] {
+            bytes.extend_from_slice(&value.to_le_bytes());
+        }
+        for page in &self.pages {
+            let (state, hash) = match page {
+                BasePage::Unknown => (0_u8, 0),
+                BasePage::Hole => (1, 0),
+                BasePage::Data(hash) => (2, *hash),
+            };
+            bytes.push(state);
+            bytes.extend_from_slice(&hash.to_le_bytes());
+        }
+        bytes
+    }
+}
+
+/// The state of a page's bytes: a hole when they are all zero.
+pub fn page_state(bytes: &[u8], seed: u64) -> BasePage {
+    if is_zero(bytes) {
+        BasePage::Hole
+    } else {
+        BasePage::Data(xxhash_rust::xxh3::xxh3_128_with_seed(bytes, seed))
+    }
+}
+
+fn is_zero(bytes: &[u8]) -> bool {
+    // SAFETY: any bit pattern is a valid u128.
+    let (head, body, tail) = unsafe { bytes.align_to::<u128>() };
+    head.iter().all(|&b| b == 0) && body.iter().all(|&w| w == 0) && tail.iter().all(|&b| b == 0)
+}
+
+/// Sources that make up the image, in order. Called once per thread, so each
+/// thread reads with its own cursors.
+pub(super) type SourceFactory<'a> =
+    dyn Fn() -> io::Result<Vec<Box<dyn SparseRamSource + 'a>>> + Sync + 'a;
+
+/// Read block `[start, start + buffer.len())` of the image into `buffer`.
+/// Parts that cannot hold data are not read and are zero. Returns whether any
+/// part may hold data.
+fn read_block(
+    sources: &mut [Box<dyn SparseRamSource + '_>],
+    starts: &[u64],
+    start: u64,
+    buffer: &mut [u8],
+) -> io::Result<bool> {
+    let end = start + buffer.len() as u64;
+    let mut data = false;
+    for (source, &base) in sources.iter_mut().zip(starts) {
+        let len = source.len();
+        if base >= end || base + len <= start {
+            continue;
+        }
+        let from = start.max(base) - base;
+        let to = end.min(base + len) - base;
+        let part = &mut buffer[(base + from - start) as usize..(base + to - start) as usize];
+        if source.has_data_in(from, to)? {
+            source.read_exact_at(part, from)?;
+            data = true;
+        } else {
+            part.fill(0);
+        }
+    }
+    Ok(data)
+}
+
+/// Build in `frame` the frame of block `block`, whose bytes are `bytes`,
+/// against the base pages `base` (all unknown when `None`). Returns the
+/// changed pages and the data bytes, or `None` when no page changed.
+fn build_frame(
+    frame: &mut Vec<u8>,
+    block: u64,
+    bytes: &[u8],
+    data: bool,
+    base: Option<&[BasePage]>,
+    seed: u64,
+) -> Option<(u64, u64)> {
+    frame.clear();
+    frame.push(FRAME_PAGES);
+    frame.extend_from_slice(&block.to_le_bytes());
+    frame.resize(FRAME_HEADER, 0);
+    let (mut pages, mut data_bytes) = (0_u64, 0_u64);
+    for (page, page_bytes) in bytes.chunks(DELTA_PAGE as usize).enumerate() {
+        let now = if data {
+            page_state(page_bytes, seed)
+        } else {
+            BasePage::Hole
+        };
+        let was = base.map_or(BasePage::Unknown, |base| base[page]);
+        if was != BasePage::Unknown && was == now {
+            continue;
+        }
+        let (byte, bit) = (9 + page / 8, 1 << (page % 8));
+        frame[byte] |= bit;
+        pages += 1;
+        if let BasePage::Data(_) = now {
+            frame[byte + BITMAP_BYTES] |= bit;
+            frame.extend_from_slice(page_bytes);
+            data_bytes += page_bytes.len() as u64;
+        }
+    }
+    (pages > 0).then_some((pages, data_bytes))
+}
+
+/// Write the delta of the image `sources` describes against `table` to
+/// `output`, reading and hashing on `threads` threads. A table for an image
+/// of another length is ignored: every page is sent.
+pub(super) fn stream_delta<W: Write + Send>(
+    sources: &SourceFactory<'_>,
+    table: &DeltaTable,
+    output: &mut W,
+    threads: usize,
+) -> io::Result<DeltaSummary> {
+    let lens: Vec<u64> = sources()?.iter().map(|source| source.len()).collect();
+    let mut starts = Vec::with_capacity(lens.len());
+    let mut image_len = 0_u64;
+    for len in lens {
+        starts.push(image_len);
+        image_len = image_len
+            .checked_add(len)
+            .ok_or_else(|| io::Error::other("memory image too large"))?;
+    }
+    if image_len == 0 {
+        return Err(io::Error::other("empty RAM image"));
+    }
+    let count = image_len.div_ceil(DELTA_BLOCK);
+    let base = (table.image_len == image_len).then_some(table.pages.as_slice());
+    output.write_all(STREAM_MAGIC)?;
+    for value in [DELTA_BLOCK, DELTA_PAGE, image_len, count] {
+        output.write_all(&value.to_le_bytes())?;
+    }
+
+    let next = AtomicU64::new(0);
+    let failed = AtomicBool::new(false);
+    let output = Mutex::new(Output {
+        writer: output,
+        summary: DeltaSummary {
+            blocks: count,
+            ..Default::default()
+        },
+    });
+    let work = || -> io::Result<()> {
+        let mut sources = sources()?;
+        let mut buffer = vec![0_u8; DELTA_BLOCK as usize];
+        let mut frame = Vec::with_capacity(FRAME_HEADER + DELTA_BLOCK as usize);
+        while !failed.load(Ordering::Relaxed) {
+            let block = next.fetch_add(1, Ordering::Relaxed);
+            if block >= count {
+                break;
+            }
+            let start = block * DELTA_BLOCK;
+            let len = (image_len - start).min(DELTA_BLOCK) as usize;
+            let bytes = &mut buffer[..len];
+            let data = read_block(&mut sources, &starts, start, bytes)?;
+            let first = (start / DELTA_PAGE) as usize;
+            let pages = len.div_ceil(DELTA_PAGE as usize);
+            let base = base.map(|base| &base[first..first + pages]);
+            let Some((pages, data_bytes)) =
+                build_frame(&mut frame, block, bytes, data, base, table.seed)
+            else {
+                continue;
+            };
+            let mut output = output.lock().unwrap();
+            output.writer.write_all(&frame)?;
+            output.summary.changed_blocks += 1;
+            output.summary.changed_pages += pages;
+            output.summary.data_bytes += data_bytes;
+        }
+        Ok(())
+    };
+    let work = || {
+        let result = work();
+        if result.is_err() {
+            failed.store(true, Ordering::Relaxed);
+        }
+        result
+    };
+    std::thread::scope(|scope| -> io::Result<()> {
+        let workers: Vec<_> = (1..threads.max(1)).map(|_| scope.spawn(work)).collect();
+        let mut result = work();
+        for worker in workers {
+            let joined = worker
+                .join()
+                .unwrap_or_else(|_| Err(io::Error::other("delta save thread panicked")));
+            result = result.and(joined);
+        }
+        result
+    })?;
+    let Output { writer, summary } = output.into_inner().unwrap();
+    writer.write_all(&[FRAME_END])?;
+    for value in [
+        summary.blocks,
+        summary.changed_blocks,
+        summary.changed_pages,
+        summary.data_bytes,
+    ] {
+        writer.write_all(&value.to_le_bytes())?;
+    }
+    Ok(summary)
+}
+
+struct Output<'w, W> {
+    writer: &'w mut W,
+    summary: DeltaSummary,
+}
