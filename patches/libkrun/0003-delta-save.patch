+/// Counts what the delta stream wrote, so a failure knows whether the stream
+/// had started and needs an abort frame before its reply.
+#[cfg(all(snapshot_supported, deferred_stream_supported, target_os = "linux"))]
+struct CountingWriter<'a, W> {
+    inner: &'a mut W,
+    written: u64,
+}
+
+#[cfg(all(snapshot_supported, deferred_stream_supported, target_os = "linux"))]
+impl<W: Write> Write for CountingWriter<'_, W> {
+    fn write(&mut self, bytes: &[u8]) -> std::io::Result<usize> {
+        let written = self.inner.write(bytes)?;
+        self.written += written as u64;
+        Ok(written)
+    }
+
+    fn flush(&mut self) -> std::io::Result<()> {
+        self.inner.flush()
+    }
+}
+
+/// `FINISH_SAVE_DELTA <dir> <table length>`, followed by the table: stream
+/// the pages of the retained RAM that differ from the caller's base (see
+/// `vmm::snapshot::DeltaTable`), then publish the checkpoint state and layout
+/// in `dir` without a memory image. Returns the reply line.
+#[cfg(all(snapshot_supported, deferred_stream_supported, target_os = "linux"))]
+fn handle_finish_save_delta<W: std::io::Read + Write + Send>(arg: &str, stream: &mut W) -> String {
+    use vmm::snapshot::{DeltaTable, FRAME_ABORT};
+    let Some((dir, len)) = arg.rsplit_once(char::is_whitespace) else {
+        return "ERR EINVAL expected snapshot dir and table length\n".to_string();
+    };
+    let dir = dir.trim_end();
+    let Some(len) = len
+        .parse::<usize>()
+        .ok()
+        .filter(|len| *len <= DeltaTable::MAX_LEN)
+    else {
+        return "ERR EINVAL invalid delta table length\n".to_string();
+    };
+    let mut table = vec![0_u8; len];
+    if let Err(error) = stream.read_exact(&mut table) {
+        return format!("ERR EIO read delta table: {error}\n");
+    }
+    let table = match DeltaTable::parse(&table) {
+        Ok(table) => table,
+        Err(error) => return format!("ERR EINVAL {error}\n"),
+    };
+    let mut output = CountingWriter {
+        inner: stream,
+        written: 0,
+    };
+    let Some(result) = PREPARED_SAVES.finish(dir, |prepared| {
+        let (descs, summary) = prepared
+            .memory
+            .finish_delta(&table, &mut output)
+            .map_err(|error| (true, format!("stream RAM delta: {error}")))?;
+        publish_portable_save(
+            std::path::Path::new(dir),
+            None,
+            prepared.checkpoint,
+            &descs,
+            true,
+        )
+        .map(|_| (summary, descs.len()))
+        .map_err(|error| (false, error))
+    }) else {
+        return "ERR ENOENT no prepared durable save\n".to_string();
+    };
+    match result {
+        Ok((summary, regions)) => format!(
+            "OK saved delta ({} blocks, {} changed, {} pages, {} bytes, {regions} regions)\n",
+            summary.blocks, summary.changed_blocks, summary.changed_pages, summary.data_bytes
+        ),
+        Err((in_frames, error)) => {
+            if in_frames && output.written > 0 {
+                let _ = output.inner.write_all(&[FRAME_ABORT]);
+            }
+            format!("ERR EIO {error}\n")
+        }
+    }
+}
+
 #[cfg(all(snapshot_supported, deferred_stream_supported))]
